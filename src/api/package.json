{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./server/www",
    "dev": "PORT=8730 node ./server/www",
    "clean": "node -e \"require('fs').rmSync('./public', {recursive: true, force: true})\"",
    "build": "node -e \"require('fs').rmSync('./public', {recursive: true, force: true})\" && cd ../ui && npm install && npm run build && shx cp -r build ../api/public",
    "copyui": "cd ../ui && shx cp -r build ../api/public"
  },
  "dependencies": {
    "@azure/ai-language-text": "^1.1.0",
    "@azure/openai": "^2.0.0",
    "axios": "^1.7.9",
    "cookie-parser": "~1.4.7",
    "debug": "~4.4.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "langchain": "^0.3.0",
    "morgan": "~1.10.0"
  },
  "devDependencies": {
    "shx": "^0.3.4"
  }
}
